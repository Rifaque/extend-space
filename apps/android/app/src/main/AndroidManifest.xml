<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The USB link is a local socket that adb forwards to and needs no permission. The Wi-Fi
         transport (D74-D79) needs to listen on the local network (INTERNET), to advertise itself by
         DNS-SD without the Wi-Fi driver filtering the PC's multicast queries
         (CHANGE_WIFI_MULTICAST_STATE), and nothing else: no location, no nearby-devices permission.
         It listens only while the user has the tablet waiting with Wi-Fi allowed, or pairing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".ExtendSpaceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExtendSpace">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The session screen (D66): opened only from the Connect screen, so not exported. -->
        <activity
            android:name=".ui.session.SessionActivity"
            android:exported="false" />
    </application>

</manifest>
