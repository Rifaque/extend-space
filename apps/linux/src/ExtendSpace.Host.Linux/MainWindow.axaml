<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExtendSpace.Host.Linux.Views"
        x:Class="ExtendSpace.Host.Linux.MainWindow"
        Title="ExtendSpace"
        Width="820" Height="860" MinWidth="520" MinHeight="480">
    <TabControl Padding="0" TabStripPlacement="Top">
        <TabItem Header="Home">
            <views:HomeView x:Name="Home" />
        </TabItem>
        <TabItem Header="Diagnostics">
            <views:DiagnosticsView />
        </TabItem>
        <TabItem Header="About">
            <views:AboutView />
        </TabItem>
    </TabControl>
</Window>
