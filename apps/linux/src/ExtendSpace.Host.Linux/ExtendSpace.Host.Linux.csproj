<Project Sdk="Microsoft.NET.Sdk">

  <!-- D96: the Linux host application, Avalonia over the shared Core view model. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>extendspace</AssemblyName>
    <RootNamespace>ExtendSpace.Host.Linux</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtendSpace.Linux\ExtendSpace.Linux.csproj" />
  </ItemGroup>

</Project>
