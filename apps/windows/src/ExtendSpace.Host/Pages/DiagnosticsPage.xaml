<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExtendSpace.Host.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExtendSpace.Host.Pages">

    <Page.Resources>
        <DataTemplate x:Key="EntryTemplate" x:DataType="local:DiagnosticEntry">
            <Grid Padding="0,6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Name}" />
                <TextBlock
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Value}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Diagnostics" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Application" />
                    <ItemsControl ItemTemplate="{StaticResource EntryTemplate}" ItemsSource="{x:Bind ApplicationEntries, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Features in this build" />
                    <ItemsControl ItemTemplate="{StaticResource EntryTemplate}" ItemsSource="{x:Bind FeatureEntries}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Stream (updated every second)" />
                    <ItemsControl ItemTemplate="{StaticResource EntryTemplate}" ItemsSource="{x:Bind StreamEntries, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Frame rates are measured where they happen: captured is what Windows delivered, sent is what reached the USB connection, and received and shown are the device's own report. A still screen sends few frames; that is not a fault."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
