<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExtendSpace.Host.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExtendSpace.Host.Pages"
    xmlns:vm="using:ExtendSpace.Core.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="OptionTemplate" x:DataType="vm:ConnectOption">
            <StackPanel Margin="0,0,0,10" Spacing="2">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Description}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind StatusNote}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(StatusNote)}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Connect" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7F4;" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{x:Bind local:HomePage.HealthBrush(ViewModel.StreamHealthIsProblem), Mode=OneWay}"
                            Text="{x:Bind ViewModel.StreamHealth, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(ViewModel.StreamHealth), Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Click="OnDisconnectClick"
                            Content="Disconnect"
                            Visibility="{x:Bind ViewModel.CanDisconnect, Mode=OneWay}" />
                        <Button
                            Click="OnConnectClick"
                            Content="Connect"
                            IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                Title="Connection failed"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Click="OnDismissErrorClick" Content="Dismiss" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                Title="Not available in this build"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsConnectBlocked, Mode=OneWay}"
                Message="{x:Bind ViewModel.ConnectBlockedReason, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind ViewModel.IsConnectBlocked, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowsDevices}">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Android device" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DevicesStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Refresh the device list"
                            Click="OnRefreshDevicesClick"
                            IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                            ToolTipService.ToolTip="Refresh">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="DeviceList"
                        IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                        SelectionChanged="OnDeviceSelectionChanged"
                        SelectionMode="Single"
                        Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceOption">
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind ViewModel.DeviceHint, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(ViewModel.DeviceHint), Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowsManualAddress, Mode=OneWay}">
                        <TextBox
                            x:Name="ManualAddress"
                            MinWidth="220"
                            AutomationProperties.Name="Tablet address"
                            IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                            PlaceholderText="Not listed? Tablet's IP address" />
                        <Button
                            AutomationProperties.Name="Add the tablet by address"
                            Click="OnAddAddressClick"
                            Content="Add"
                            IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind ViewModel.ManualAddressError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(ViewModel.ManualAddressError), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.Name="Pair with the chosen tablet"
                            Click="OnPairClick"
                            Content="Pair…"
                            Visibility="{x:Bind ViewModel.CanPair, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="Forget the chosen tablet"
                            Click="OnForgetClick"
                            Content="Forget"
                            Visibility="{x:Bind ViewModel.CanForget, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PairingStatus, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(ViewModel.PairingStatus), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowsExtendStatus, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Extended display" />
                    <TextBlock
                        Foreground="{x:Bind local:HomePage.HealthBrush(ViewModel.ExtendIsProblem), Mode=OneWay}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.ExtendStatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.ModeAdviceText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(ViewModel.ModeAdviceText), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnApplyModeClick"
                            Content="{x:Bind ViewModel.ApplyRecommendedModeLabel, Mode=OneWay}"
                            ToolTipService.ToolTip="Changes the virtual display only; your monitors keep their settings."
                            Visibility="{x:Bind ViewModel.CanApplyRecommendedMode, Mode=OneWay}" />
                        <Button
                            Click="OnBringWindowsBackClick"
                            Content="Bring windows back"
                            ToolTipService.ToolTip="Moves windows on the virtual display to your main display."
                            Visibility="{x:Bind ViewModel.CanBringWindowsBack, Mode=OneWay}" />
                        <HyperlinkButton Content="Display settings" NavigateUri="ms-settings:display" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowsDisplayChoice, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Display to mirror" />
                    <ComboBox
                        x:Name="DisplayList"
                        MinWidth="320"
                        AutomationProperties.Name="Display to mirror"
                        IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Displays, Mode=OneWay}"
                        SelectionChanged="OnDisplaySelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DisplayOption">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <RadioButtons
                        x:Name="TransportOptions"
                        Header="Connection"
                        IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                        ItemTemplate="{StaticResource OptionTemplate}"
                        ItemsSource="{x:Bind ViewModel.TransportOptions}"
                        SelectionChanged="OnTransportSelectionChanged" />
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <RadioButtons
                        x:Name="ModeOptions"
                        Header="Mode"
                        IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                        ItemTemplate="{StaticResource OptionTemplate}"
                        ItemsSource="{x:Bind ViewModel.ModeOptions}"
                        SelectionChanged="OnModeSelectionChanged" />
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowsInput}">
                <StackPanel Spacing="8">
                    <RadioButtons
                        x:Name="InputOptions"
                        Header="Input from the tablet"
                        ItemTemplate="{StaticResource OptionTemplate}"
                        ItemsSource="{x:Bind ViewModel.InputOptions}"
                        MaxColumns="3"
                        SelectionChanged="OnInputSelectionChanged" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.InputNote, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(ViewModel.InputNote), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
