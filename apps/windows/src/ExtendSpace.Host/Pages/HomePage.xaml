<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExtendSpace.Host.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExtendSpace.Host.Pages"
    xmlns:vm="using:ExtendSpace.Core.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="OptionTemplate" x:DataType="vm:ConnectOption">
            <StackPanel Margin="0,0,0,10" Spacing="2">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Description}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind StatusNote}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:HomePage.VisibleWhenNotEmpty(StatusNote)}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Connect" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7F4;" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Click="OnDisconnectClick"
                            Content="Disconnect"
                            Visibility="{x:Bind ViewModel.CanDisconnect, Mode=OneWay}" />
                        <Button
                            Click="OnConnectClick"
                            Content="Connect"
                            IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                Title="Connection failed"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Click="OnDismissErrorClick" Content="Dismiss" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                Title="Not available in this build"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsConnectBlocked, Mode=OneWay}"
                Message="{x:Bind ViewModel.ConnectBlockedReason, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind ViewModel.IsConnectBlocked, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <RadioButtons
                        x:Name="TransportOptions"
                        Header="Connection"
                        IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                        ItemTemplate="{StaticResource OptionTemplate}"
                        ItemsSource="{x:Bind ViewModel.TransportOptions}"
                        SelectionChanged="OnTransportSelectionChanged" />
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <RadioButtons
                        x:Name="ModeOptions"
                        Header="Mode"
                        IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}"
                        ItemTemplate="{StaticResource OptionTemplate}"
                        ItemsSource="{x:Bind ViewModel.ModeOptions}"
                        SelectionChanged="OnModeSelectionChanged" />
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
