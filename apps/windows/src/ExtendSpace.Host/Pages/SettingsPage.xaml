<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExtendSpace.Host.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <Border Style="{StaticResource CardStyle}">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="There are no settings yet."
                    TextWrapping="Wrap" />
            </Border>

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ExtendSpace" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind VersionText}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Developed by RSX Develops. Released under the MIT License." />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Early development build. Connecting, mirroring and extending are not implemented yet."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
