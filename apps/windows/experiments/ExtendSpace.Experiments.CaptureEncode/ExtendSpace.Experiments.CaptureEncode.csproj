<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 is the supported floor, as for the host. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>ExtendSpace.Experiments.CaptureEncode</RootNamespace>
    <AssemblyName>ExtendSpace.CaptureEncode</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time source generator for the Direct3D 11 and Media Foundation declarations listed in
         NativeMethods.txt. Nothing from it ships at run time. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExtendSpace.Experiments.CaptureEncode.Tests" />
  </ItemGroup>

</Project>
