<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>RSX Develops</Company>
    <Product>ExtendSpace</Product>
    <!-- D71: the release version, the same on Windows and Android (docs/release/release-process.md).
         VersionPrefix is what the host tells the device in hello; the suffix labels pre-releases. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
  </PropertyGroup>
</Project>
